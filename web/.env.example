# Leave DATABASE_URL unset only for the non-persistent seeded development fallback.
# For PostgreSQL, copy this file to .env and use the Compose URL below or a managed service URL.
DATABASE_URL=postgresql://autotyper:autotyper@localhost:5432/autotyper

PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Set true for managed PostgreSQL services that require TLS (for example Neon).
DATABASE_SSL=false
