{
  "name": "autotyper-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "description": "MurGee-inspired Auto Typer, available in the browser and as a Windows desktop app.",
  "author": "Pulkit Sulekh",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.js",
    "migrate": "node server/migrate.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --dir --win --x64",
    "desktop:package": "npm run build && electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.pulkitsu.autotyper.desktop",
    "productName": "AutoTyper Desktop",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "AutoTyper-Desktop-${version}-portable.exe"
    }
  }
}
